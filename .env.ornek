# ════════════════════════════════════════════════════════════════════
#  SUNUCU (.env) — Lokal Python scriptleri için
#  Bu dosyayı .env olarak kopyala, değerleri doldur.
#  GİT'E GİTMEZ — .gitignore'a .env ekle!
# ════════════════════════════════════════════════════════════════════

# GitHub
GITHUB_TOKEN=ghp_BURAYA_TOKEN_YAZ
GITHUB_REPO_OWNER=ipapila
GITHUB_REPO_NAME=ekoloji-izleme.com

# Anthropic (geojson_uret.py için)
ANTHROPIC_API_KEY=sk-ant-BURAYA_KEY

# Flex webhook
FLEX_WEBHOOK_URL=https://BURAYA_WEBHOOK_URL
FLEX_WEBHOOK_SECRET=BURAYA_SECRET


# ════════════════════════════════════════════════════════════════════
#  GITHUB ACTIONS SECRETS — Repo → Settings → Secrets and variables
#  → Actions → New repository secret
#  Aşağıdaki değişkenleri workflow'lar otomatik okur, .env'e BAKMAZ.
# ════════════════════════════════════════════════════════════════════
#
#  Secret adı             Açıklama
#  ─────────────────────  ──────────────────────────────────────────
#  GITHUB_TOKEN           Otomatik sağlanır, eklemeye gerek yok
#  FLEX_WEBHOOK_URL       Flex sunucu webhook adresi
#  FLEX_WEBHOOK_SECRET    Webhook doğrulama anahtarı
#
#  Hangi workflow hangi secret'ı kullanır:
#
#  tara.yml               → update_data.yml + haber-tarama.yml'i çağırır
#  update_data.yml        → GITHUB_TOKEN, FLEX_WEBHOOK_URL, FLEX_WEBHOOK_SECRET
#  haber-tarama.yml       → GITHUB_TOKEN
