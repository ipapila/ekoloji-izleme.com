# ekoloji-izleme.com — .htaccess
# ⚠️  Bu dosyayı sunucuya ".htaccess" adıyla koyun (noktalı, önde)

Options -Indexes

# ── Gzip Sıkıştırma ──────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/plain
</IfModule>

# ── Cache Kontrol ─────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # JSON verileri: 5 dakika (scraper sürekli günceller)
  <FilesMatch "\.json$">
    ExpiresDefault "access plus 5 minutes"
    Header set Cache-Control "public, max-age=300, stale-while-revalidate=60"
  </FilesMatch>

  # CSS & JS: 1 gün (değişince dosyaya ?v=xxx ekle)
  <FilesMatch "\.(css|js)$">
    ExpiresDefault "access plus 1 day"
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # Görseller: 7 gün
  <FilesMatch "\.(png|jpg|jpeg|gif|webp|svg|ico)$">
    ExpiresDefault "access plus 7 days"
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# ── CORS (JSON dosyaları için) ────────────────────────────────────
<FilesMatch "\.json$">
  Header set Access-Control-Allow-Origin "https://ekoloji-izleme.com"
  Header append Access-Control-Allow-Origin "https://www.ekoloji-izleme.com"
</FilesMatch>

# ── Güvenlik Başlıkları ───────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # PHP dosyalarına dışarıdan erişimi engelle (webhook.php hariç)
  <FilesMatch "^(upload|webhook)\.php$">
    Header always set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

# ── PHP dosyaları dizin kökünde gizle ────────────────────────────
<FilesMatch "^(env_yukle|temizle|dagitici|dedup_utils|geojson_uret|guncelle|rapor_uret|tarayici)\.py$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(env|bak|tmp|pyc|pyo|log)$">
  Require all denied
</FilesMatch>
