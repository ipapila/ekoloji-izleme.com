# ekoloji-izleme.com — .gitignore
# ⚠️  Bu dosyanın adı ".gitignore" olmalı (noktalı, önde)

# Gizli bilgiler — git'e gitmez
.env

# Python
__pycache__/
*.pyc
*.pyo

# OS
.DS_Store
Thumbs.db

# Veri dosyaları (dinamik, Plesk'te üretiliyor — git'e girmez)
haberler.json
haberler_veri.json
raporlar_veri.json
makaleler_veri.json
uluslararasi_veri.json
ekosistem_veri.json
data.json
ihlaller.json
rapor.json
icerik.json
*.tmp

# PHP geçici dosyalar
*.tmp.*

# Log dosyaları
*.log
